// ── Expiry ───────────────────────────────────────────────────────────

// Whether a session has ended under a policy, at a time the caller
// supplies.
//
// Checks BOTH timeouts.  A deployment with only the idle one has
// sessions a stolen cookie in an automated loop keeps alive forever,
// which is exactly the session an attacker has.
//
// ```novo
// use civil
// use sess
// use sessid
// use uuid
//
// fn a_moment() -> civil.CivilDateTime
//     civil.datetime(civil.date_from_epoch_day(20000), civil.midnight())
//
// fn a_session() -> sess.Sess
//     sess.fresh(sessid.of_uuid(uuid.nil()), a_moment())
//
// fn main() [io]
//     println("${sess.is_expired(a_session(), sess.defaults(), a_moment())}")
// ```
pub fn is_expired(s: Sess, p: SessPolicy, now: civil.CivilDateTime) -> Bool []
    todo("session-nv.sess.is_expired")

// WHICH timeout ended it: `idle`, `absolute`, or empty where it has
// not ended.
//
// For the log line an operator reads when people complain about being
// logged out.  The two have different fixes and a message that says
// only "session expired" does not tell them apart.
//
// ```novo
// use civil
// use sess
// use sessid
// use uuid
//
// fn a_moment() -> civil.CivilDateTime
//     civil.datetime(civil.date_from_epoch_day(20000), civil.midnight())
//
// fn a_session() -> sess.Sess
//     sess.fresh(sessid.of_uuid(uuid.nil()), a_moment())
//
// fn main() [io]
//     println(sess.expiry_reason(a_session(), sess.defaults(), a_moment()))
// ```
pub fn expiry_reason(s: Sess, p: SessPolicy, now: civil.CivilDateTime) -> Str []
    todo("session-nv.sess.expiry_reason")

// When the session ends: the earlier of the two timeouts.
//
// What goes in a record's `expires_at` and in a cookie's `Max-Age`.
//
// ```novo
// use civil
// use sess
// use sessid
// use uuid
//
// fn a_moment() -> civil.CivilDateTime
//     civil.datetime(civil.date_from_epoch_day(20000), civil.midnight())
//
// fn a_session() -> sess.Sess
//     sess.fresh(sessid.of_uuid(uuid.nil()), a_moment())
//
// fn main() [io]
//     println("${sess.expires_at(a_session(), sess.defaults()).date.year}")
// ```
pub fn expires_at(s: Sess, p: SessPolicy) -> civil.CivilDateTime []
